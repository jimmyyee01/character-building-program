# Character Building Program — Apache routing (PHP + MySQL build)
# Point your domain/subdomain document root (or XAMPP VirtualHost) at this folder.
RewriteEngine On

# JSON API -> PHP router (identical paths to the previous backend: /api/...)
RewriteRule ^api/(.*)$ php/api.php?r=/$1 [QSA,L]

# OPcache flush helper: lets a fresh pull take effect without hunting for the
# service name (open /cache-clear.php; it only drops compiled bytecode)
RewriteRule ^cache-clear(\.php)?/?$ public/cache-clear.php [L]

# Pretty pages
RewriteRule ^t/([A-Za-z0-9-]+)/?$ public/login.html [L]
RewriteRule ^super/?$ public/super.html [L]
RewriteRule ^admin/?$ public/admin.html [L]
RewriteRule ^app/?$ public/app.html [L]
RewriteRule ^$ public/index.html [L]

# Static assets live in public/
RewriteRule ^(css|js)/(.*)$ public/$1/$2 [L]

# Uploads are stored at the project root /uploads/
# (nothing to rewrite — served directly)

# Media uploads (audio/video library entries)
AddType audio/mpeg .mp3
AddType audio/mp4 .m4a
AddType audio/aac .aac
AddType audio/wav .wav
AddType audio/flac .flac
AddType audio/ogg .ogg .oga
AddType video/mp4 .mp4 .m4v
AddType video/quicktime .mov
AddType video/webm .webm
AddType video/ogg .ogv

# Keep PHP internals out of direct browser access except api.php/install.php
<FilesMatch "^(config|engine|routes_.*|seed_data)\.php$">
    Require all denied
</FilesMatch>
